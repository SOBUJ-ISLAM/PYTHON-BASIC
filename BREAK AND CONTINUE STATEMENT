#  BREAK AND CONTINUE STATEMENT

# BREAK STEATMENT
# The break statement enables a program to skip over a part of the code. A break statement terminates the very loop

a=int(input("Enter a number: "))
for i in  range(14):
  print ("a*", i+1, "=", a* (i+1))
  if (i == 9):
     break
print ("the table of a is done")

i = 0
while True:
  print(i)
  i = i + 1
  if (i % 50 == 0):
    break

# CONTINUE STATEMENT
# The continue statement skips the rest of the loop statements and causes the next iteration

a=int(input("Enter a number: "))
for i in  range(14):
  if (i == 9):
    print ("skip the iteration")
    continue
  print ("a*", i+1, "=", a* (i+1))

print ("the table of a is done")
